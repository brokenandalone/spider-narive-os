SPIDER_OS_NAME="Spider OS"
SPIDER_OS_ID="spider-os"
SPIDER_OS_VERSION="0.1-dev"

# Ubuntu Studio 26.04 LTS release image for reconciliation with the installed Spider OS.
# The owner reports Ubuntu 26.04 on the PC. Its exact point-version and local file inventory
# remain unverified; 26.04.1 is the pinned official ISO for new build qualification.
# Keep the installed machine unchanged. Ubuntu Studio 26.10 testing stays on its own branch.
UBUNTU_RELEASE="26.04"
UBUNTU_CODENAME="resolute"
UBUNTU_CHANNEL="release"
UBUNTU_IMAGE_VERSION="26.04.1"
UBUNTU_IMAGE_NAME="ubuntustudio-${UBUNTU_IMAGE_VERSION}-desktop-amd64.iso"
UBUNTU_RELEASE_PATH="${UBUNTU_RELEASE}/${UBUNTU_CHANNEL}"
UBUNTU_CDIMAGE_BASE="https://cdimage.ubuntu.com/ubuntustudio/releases"

SPIDER_DESKTOP="kde"
SPIDER_SHELL="the-web"

SPIDER_WEBBIE_ENABLED="1"
SPIDER_WEBBIE_VOICE_REQUIRED="1"

SPIDER_FORAGE_ENABLED="1"
SPIDER_DEEP_FORAGE_ENABLED="1"

SPIDER_KALI_BAY_ENABLED="1"
SPIDER_KALI_FULL_TOOLSET="1"
