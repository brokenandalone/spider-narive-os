SPIDER_OS_NAME="Spider OS"
SPIDER_OS_ID="spider-os"
SPIDER_OS_VERSION="0.1-dev"

# Ubuntu Studio foundation for the 26.10 migration branch.
# Stonking Stingray is currently beta. When final ships, only the channel/image
# values should need to change; the rest of the migration logic stays the same.
UBUNTU_RELEASE="26.10"
UBUNTU_CODENAME="stonking"
UBUNTU_CHANNEL="beta"
UBUNTU_IMAGE_VERSION="26.10-beta"
UBUNTU_IMAGE_NAME="ubuntustudio-${UBUNTU_IMAGE_VERSION}-desktop-amd64.iso"
UBUNTU_RELEASE_PATH="${UBUNTU_RELEASE}/${UBUNTU_CHANNEL}"
UBUNTU_CDIMAGE_BASE="https://cdimage.ubuntu.com/ubuntustudio/releases"

SPIDER_DESKTOP="kde"
SPIDER_SHELL="the-web"

SPIDER_WEBBIE_ENABLED="1"
SPIDER_WEBBIE_VOICE_REQUIRED="1"

SPIDER_FORAGE_ENABLED="1"
SPIDER_DEEP_FORAGE_ENABLED="1"

SPIDER_KALI_BAY_ENABLED="1"
SPIDER_KALI_FULL_TOOLSET="1"
