Window.SetBackgroundTopColor(0.02, 0.01, 0.03);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);

logo = Image("spider-os-splash.png");
sprite = Sprite(logo);

sprite.SetX(
    Window.GetWidth() / 2 -
    logo.GetWidth() / 2
);

sprite.SetY(
    Window.GetHeight() / 2 -
    logo.GetHeight() / 2
);
