#!/usr/bin/env bash
set -Eeuo pipefail

NAME="kali-bay"
IMAGE="docker.io/kalilinux/kali-rolling"

STATE_DIR="${HOME}/.local/state/spider-os/kali-bay"
DATA_DIR="${HOME}/.local/share/spider-os/kali-bay"
KALI_HOME="${DATA_DIR}/home"
READY_FILE="${STATE_DIR}/full-toolset.ready"

SCRIPT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
    pwd
)"

KALI_ROOT="$(
    cd -- "${SCRIPT_DIR}/.."
    pwd
)"

mkdir -p \
    "${STATE_DIR}" \
    "${DATA_DIR}" \
    "${KALI_HOME}"


die() {
    printf 'Kali Bay: %s\n' "$*" >&2
    exit 1
}


require_host_tools() {
    command -v podman >/dev/null 2>&1 \
        || die "Podman is not installed."

    command -v distrobox >/dev/null 2>&1 \
        || die "Distrobox is not installed."
}


container_exists() {
    podman container exists "${NAME}" \
        >/dev/null 2>&1
}


full_toolset_installed() {
    container_exists || return 1

    # Status must not trigger Distrobox's first-run package installation.
    [[ "$(podman inspect --format '{{.State.Running}}' "${NAME}" 2>/dev/null)" == 'true' ]] || return 1

    podman exec --user 0 --tty=false "${NAME}" \
        sh -c 'dpkg-query -W -f="${Status}" kali-linux-everything 2>/dev/null | grep -q "install ok installed"' \
        >/dev/null 2>&1
}


create_container() {
    require_host_tools

    if container_exists; then
        echo "Kali Bay container already exists."
        return
    fi

    echo
    echo "Creating isolated Kali Bay..."
    echo "Image: ${IMAGE}"
    echo "Dedicated home: ${KALI_HOME}"
    echo

    distrobox create \
        --name "${NAME}" \
        --image "${IMAGE}" \
        --home "${KALI_HOME}" \
        --yes

    echo
    echo "Kali Bay container created."
}


setup_full() {
    require_host_tools
    create_container

    echo
    echo "============================================"
    echo "       KALI BAY FULL TOOLSET SETUP"
    echo "============================================"
    echo
    echo "Installing kali-linux-everything."
    echo "This is the complete Kali metapackage."
    echo
    echo "The installation is intentionally inside"
    echo "Kali Bay, NOT on the Spider OS Ubuntu host."
    echo
    echo "============================================"
    echo

    distrobox enter \
        --name "${NAME}" \
        -- \
        bash -lc '
            set -e

            echo
            echo "=== KALI REPOSITORY UPDATE ==="
            sudo apt-get update

            echo
            echo "=== INSTALLING FULL KALI TOOLSET ==="

            sudo env \
                DEBIAN_FRONTEND=noninteractive \
                apt-get install \
                -y \
                kali-linux-everything

            echo
            echo "=== CLEANING PACKAGE CACHE ==="
            sudo apt-get clean

            echo
            echo "=== VERIFYING ==="

            dpkg-query \
                -W \
                -f="${Status}\n" \
                kali-linux-everything
        '

    if full_toolset_installed; then
        date -Iseconds > "${READY_FILE}"

        echo
        echo "============================================"
        echo "      FULL KALI BAY IS INSTALLED"
        echo "============================================"
    else
        rm -f "${READY_FILE}"

        die "Full Kali toolset verification failed."
    fi
}


doctor() {
    require_host_tools

    echo "KALI BAY DIAGNOSTICS (READ ONLY)"
    if ! container_exists; then
        echo "Container: missing"
        echo "Run 'kali-bay create' to initialize it."
        return 0
    fi

    local state
    state="$(podman inspect --format '{{.State.Status}}' "${NAME}" 2>/dev/null)" \
        || die "Unable to inspect Kali Bay."
    echo "Container: ${state}"

    if [[ "${state}" != 'running' ]]; then
        echo "No package repair attempted; start Kali Bay before investigating packages."
        return 0
    fi

    # Direct Podman execution avoids triggering Distrobox's setup flow.
    podman exec --user 0 --tty=false "${NAME}" sh -c '
        echo "Package database audit:"
        dpkg --audit || true
        echo "Previously failing packages:"
        dpkg-query -W -f="${Package}: ${Status}\\n" systemd udev kali-linux-everything 2>/dev/null || true
        echo "Running package-manager processes:"
        ps -eo pid,comm,args | grep -E "[a]pt-get|[d]pkg" || true
    '
    echo "No host configuration or container packages were modified."
}


update_kali() {
    require_host_tools

    container_exists \
        || die "Kali Bay has not been initialized."

    echo
    echo "Updating Kali Bay..."

    distrobox enter \
        --name "${NAME}" \
        -- \
        bash -lc '
            set -e
            sudo apt-get update
            sudo env \
                DEBIAN_FRONTEND=noninteractive \
                apt-get full-upgrade \
                -y
            sudo apt-get clean
        '

    echo
    echo "Kali Bay update complete."
}


open_terminal() {
    require_host_tools

    container_exists \
        || die "Kali Bay is not configured. Use the explicit setup controls first."

    if command -v konsole >/dev/null 2>&1; then
        exec konsole \
            -e \
            distrobox enter \
            --name "${NAME}"
    fi

    exec distrobox enter \
        --name "${NAME}"
}


# Opening the package workbench never installs, upgrades or removes software.
# The owner gets a genuine interactive Kali shell and manually chooses apt
# operations INSIDE the Kali container, without modifying Ubuntu repositories.
open_packages() {
    require_host_tools
    container_exists || die "Kali Bay container missing. Configure Kali first."
    if command -v konsole >/dev/null 2>&1; then
        exec konsole --hold -e distrobox enter --name "${NAME}" -- bash -lc '
            printf "\\nKALI BAY / KALI PACKAGE MANAGER\\n"
            printf "This is Kali Linux apt, NOT Ubuntu apt.\\n"
            printf "Use apt search, apt show, sudo apt install, etc. as needed.\\n"
            printf "Nothing has been installed or upgraded automatically.\\n\\n"
            exec bash -l'
    fi
    exec distrobox enter --name "${NAME}" -- bash -l
}

# The inventory only reads the package database. No external searches, package
# changes, container starts or privileged host operations.
inventory() {
    require_host_tools
    container_exists || die "No Kali Bay container is configured."
    local running
    running="$(podman inspect --format '{{.State.Running}}' "${NAME}" 2>/dev/null)" \
        || die "Kali container state cannot be inspected."
    [[ "${running}" == "true" ]] \
        || die "Kali container is stopped. Open the Kali terminal deliberately."
    podman exec --user 0 --tty=false "${NAME}" sh -c '
        echo "Installed Kali package inventory (read only)"
        dpkg-query -W -f="\${binary:Package}\n" 2>/dev/null |
          awk "BEGIN {n=0} {n++; if (\$0 ~ /^kali-(tools|linux|desktop)/ && shown < 90) {print; shown++}}
               END {printf \"Total installed packages: %d\\n\", n}"
    '
}

category_shell() {
    local meta="${1:-kali-linux-everything}"
    local title="${2:-Kali Bay}"

    require_host_tools

    container_exists \
        || die "Initialize Kali Bay first."

    if command -v konsole >/dev/null 2>&1; then
        exec konsole \
            --hold \
            -e \
            distrobox enter \
            --name "${NAME}" \
            -- \
            bash -lc "
                clear

                printf '\n'
                printf 'KALI BAY\n'
                printf '%s\n' '${title}'
                printf '========================================\n'
                printf 'Kali metapackage: %s\n' '${meta}'
                printf '\n'

                if dpkg-query \
                    -W \
                    -f='\${Status}' \
                    '${meta}' \
                    2>/dev/null \
                    | grep -q \
                    'install ok installed'
                then
                    printf 'Category installed and ready.\n'
                else
                    printf 'Category package is not installed yet.\n'
                    printf 'Run full Kali Bay setup first.\n'
                fi

                printf '\n'
                printf 'Authorized systems and labs only.\n'
                printf '\n'

                exec bash
            "
    fi

    distrobox enter \
        --name "${NAME}"
}


# No arbitrary executable names, shell fragments or arguments are accepted.
# Kali GUI programs run as the existing container user, never as root.
# The full Kali applications menu is sourced from distro-owned .desktop
# launchers in the running container, not a list guessed by Spider OS.
# App IDs are exact basenames. Never accept arbitrary file paths or arguments.
app_id_valid() {
    local id="${1:-}"
    [[ "${#id}" -le 108 && "${id}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*\.desktop$ ]] \
        || die "Invalid Kali desktop application identifier."
}
app_ready() {
    require_host_tools
    container_exists || die "Kali Bay container is missing."
    local running
    running="$(podman inspect --format '{{.State.Running}}' "${NAME}" 2>/dev/null)" \
        || die "Cannot inspect Kali container."
    [[ "${running}" == "true" ]] \
        || die "Kali container is stopped. Open its terminal deliberately."
}
apps_json() {
    app_ready
    [[ -f "${KALI_ROOT}/runtime/kali_apps.py" ]] \
        || die "Kali application inventory module is missing."
    # Read-only: stream the packaged, fixed Python source to the Kali
    # interpreter. No user-provided expressions, shell or file system edits.
    podman exec --user 0 --tty=false --interactive "${NAME}" python3 - \
        < "${KALI_ROOT}/runtime/kali_apps.py"
}
app_check() {
    app_id_valid "${1:-}"
    app_ready
    podman exec --user 0 --tty=false "${NAME}" sh -c \
      'test -f "/usr/share/applications/$1" && command -v gio >/dev/null 2>&1' \
      sh "$1" || die "This Kali application or the required gio launcher is missing."
    printf 'ready\n'
}
app_open() {
    local id="${1:-}"
    app_check "${id}" >/dev/null
    # gio reads the actual Kali system desktop entry and uses its declared
    # Exec field as intended. No bash expansion and no arbitrary host command.
    exec distrobox enter --name "${NAME}" -- \
        gio launch "/usr/share/applications/${id}"
}

tool_metadata() {
    TOOL_BINARY=""
    TOOL_MODE=""
    case "${1:-}" in
        wireshark|burpsuite|zaproxy|ghidra|clamtk)
            TOOL_BINARY="$1"
            TOOL_MODE="gui"
            ;;
        nmap|msfconsole|suricata|yara|lynis)
            TOOL_BINARY="$1"
            TOOL_MODE="terminal"
            ;;
        *)
            die "Unknown tool identifier. Refusing arbitrary command execution."
            ;;
    esac
}

tool_check() {
    tool_metadata "${1:-}"
    require_host_tools
    container_exists || die "Kali Bay does not exist yet. No setup was started."
    local running
    running="$(podman inspect --format '{{.State.Running}}' "${NAME}" 2>/dev/null)" \
        || die "Cannot inspect Kali Bay."
    [[ "${running}" == "true" ]] \
        || die "Kali Bay is stopped. Start it deliberately from the terminal."
    podman exec --user 0 --tty=false "${NAME}" \
        sh -c 'command -v "$1" >/dev/null 2>&1' sh "${TOOL_BINARY}" \
        || die "${TOOL_BINARY} is not installed in Kali Bay."
    printf 'ready\n'
}

launch_tool() {
    local tool_id="${1:-}"
    tool_check "${tool_id}" >/dev/null
    if [[ "${TOOL_MODE}" == "gui" ]]; then
        exec distrobox enter --name "${NAME}" -- "${TOOL_BINARY}"
    fi

    # CLI choices only open a labeled interactive workbench. They do not
    # run a scan or start a daemon without a subsequent user command.
    if command -v konsole >/dev/null 2>&1; then
        exec konsole --hold -e distrobox enter --name "${NAME}" -- \
            bash -lc 'printf "KALI BAY: %s is installed.\n" "$1"; printf "No action has been run.\n"; exec bash' \
            kali-bay "${TOOL_BINARY}"
    fi
    exec distrobox enter --name "${NAME}" -- \
        bash -lc 'printf "KALI BAY: %s is installed.\n" "$1"; printf "No action has been run.\n"; exec bash' \
        kali-bay "${TOOL_BINARY}"
}


status() {
    if full_toolset_installed; then
        echo "ready"
        exit 0
    fi

    if container_exists; then
        echo "container"
        exit 0
    fi

    echo "missing"
}


info() {
    echo "Name: Kali Bay"
    echo "Container: ${NAME}"
    echo "Image: ${IMAGE}"
    echo "Home: ${KALI_HOME}"
    echo "Status: $(status)"

    if [[ -f "${READY_FILE}" ]]; then
        echo "Full setup: $(cat "${READY_FILE}")"
    fi
}


launch_ui() {
    exec python3 \
        "${KALI_ROOT}/ui/kali_bay.py" "$@"
}


case "${1:-ui}" in
    ui)
        launch_ui
        ;;
    offensive|purple)
        launch_ui "--$1"
        ;;
    apps-json)
        apps_json
        ;;
    app-check)
        app_check "${2:-}"
        ;;
    app-open)
        app_open "${2:-}"
        ;;
    tool-check)
        tool_check "${2:-}"
        ;;
    tool)
        launch_tool "${2:-}"
        ;;

    create)
        create_container
        ;;

    setup|install|provision)
        setup_full
        ;;

    terminal|shell|enter)
        open_terminal
        ;;
    packages)
        open_packages
        ;;
    inventory)
        inventory
        ;;

    update|upgrade)
        update_kali
        ;;

    category)
        category_shell \
            "${2:-kali-linux-everything}" \
            "${3:-Kali Bay}"
        ;;

    status)
        status
        ;;
    doctor)
        doctor
        ;;

    info)
        info
        ;;

    *)
        cat <<EOF
Usage:
  kali-bay
  kali-bay setup
  kali-bay terminal
  kali-bay packages  # interactive Kali apt shell
  kali-bay inventory # read-only Kali package inventory
  kali-bay update
  kali-bay status
  kali-bay doctor
  kali-bay apps-json   # read-only installed Kali desktop applications
  kali-bay app-check <system.desktop>
  kali-bay app-open <system.desktop> # only on explicit user click
  kali-bay tool-check <approved-id>
  kali-bay tool <approved-id>
  kali-bay offensive|purple
  kali-bay info
  kali-bay category <metapackage> <title>
EOF
        exit 2
        ;;
esac
