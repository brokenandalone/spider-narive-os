#!/usr/bin/python3

"""Run Lorax mkefiboot with a larger EFI image and safe FAT copying."""

import os
import subprocess
from os.path import abspath, join

from pylorax import imgutils
from pylorax.cmdline import mkefiboot as command


def copytree_without_fat_timestamps(src, dest, preserve=True):
    """Copy EFI files without preserving timestamps on the FAT image."""
    subprocess.run(
        [
            "cp",
            "-R",
            "-L",
            join(src, "."),
            abspath(dest),
        ],
        check=True,
    )


def roomy_mkefiboot(bootdir, outfile, label):
    size_mib = int(os.environ.get("SPIDER_EFI_BOOT_SIZE_MIB", "64"))

    if size_mib < 32:
        raise ValueError(
            "SPIDER_EFI_BOOT_SIZE_MIB must be at least 32"
        )

    imgutils.copytree = copytree_without_fat_timestamps

    return imgutils.mkdosimg(
        None,
        outfile,
        size=size_mib * 1024 * 1024,
        label=label,
        graft={"EFI/BOOT": bootdir},
    )


command.mkefiboot = roomy_mkefiboot
command.main()
