[Unit]
Description=Webbie Resident AI for Spider OS
Documentation=https://github.com/brokenandalone/spider-narive-os
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/spider-os/webbie/agent/webbie.py
Restart=always
RestartSec=3
TimeoutStopSec=10

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
